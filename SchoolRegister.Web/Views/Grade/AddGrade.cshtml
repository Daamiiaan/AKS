@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm
@{
    ViewData["Title"] = "Add Grade";
}

<h2>Add Grade for: @ViewBag.StudentName</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddGrade">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="StudentId" type="hidden" />
            <input asp-for="TeacherId" type="hidden" />
            <div class="form-group">
                <label class="control-label">Subject</label>
                <select asp-for="SubjectId" class="form-control"
                        asp-items="@ViewBag.SubjectsSelectList"></select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Grade</label>
                <select asp-for="GradeValue" class="form-control"
                        asp-items="@ViewBag.GradeValues"></select>
                <span asp-validation-for="GradeValue" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Save Grade" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<a asp-controller="Student" asp-action="Index">Back to Students</a>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
