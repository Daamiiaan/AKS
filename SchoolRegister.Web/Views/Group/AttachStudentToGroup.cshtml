@model SchoolRegister.ViewModels.VM.AttachDetachStudentToGroupVm
@{
    ViewData["Title"] = "Add Student to Group";
}

<h2>Add Student to Group: @ViewBag.GroupName</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachStudentToGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="GroupId" type="hidden" />
            <div class="form-group">
                <label class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control"
                        asp-items="@ViewBag.StudentsSelectList"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Add" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<a asp-action="Index">Back to List</a>
